POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://q:change-me@localhost:5432/q

OPENAI_API_KEY=
# Reserved for later model routing; the first working loop uses Q_MODEL_MINI throughout.
Q_MODEL_STANDARD=
Q_MODEL_REASONING=
# Set an accessible model ID supporting structured output. Used for the full loop and consolidation.
Q_MODEL_MINI=
# Optional reasoning effort for Q_MODEL_MINI (e.g. low, medium, high); empty uses the model default.
Q_REASONING_EFFORT=
# Eval-only entailment judge for doctor notes (scripts.run_scenarios --judge); empty uses Q_MODEL_MINI.
Q_JUDGE_MODEL=

# Doctor-handoff intake notes (JSON). Defaults to ./handoffs.
Q_HANDOFF_DIR=

# Streamlit UI connects to the API over HTTP.
Q_API_URL=http://localhost:8000

# Optional LangSmith tracing. Enable after setting the API key and regional endpoint.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=q-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional for API keys linked to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Set both true to omit trace inputs/outputs when using non-synthetic health data.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
